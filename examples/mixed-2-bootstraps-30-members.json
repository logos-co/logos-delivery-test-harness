{
  "_comment": [
    "Mixed fleet: a logosdeliverynode bootstrap and a delivery-module bootstrap;",
    "30 members at T0, 15 of each kind, joining through the two bootstraps",
    "round-robin; one native member joins at T0+2min and one module member at",
    "T0+12min. Run: HARNESS_MANIFEST=examples/mixed-2-bootstraps-30-members.json ./harness.sh run 1500"
  ],
  "module": {
    "_comment": [
      "Override without editing this file:",
      "  DELIVERY_MODULE_REF=<branch|tag|full-sha>  DELIVERY_MODULE_REV=<full-sha>",
      "and likewise DELIVERY_*, LIBP2P_MODULE_*, OPENMETRICS_MODULE_*,",
      "LOGOSCORE_CLI_* for the dependencies this module otherwise chooses.",
      "A branch is not a pin: out/resolved.json records the commit it resolved to."
    ],
    "flake": "git+https://github.com/logos-co/logos-delivery-module",
    "ref": "master"
  },
  "overrides": {
    "_comment": [
      "Only what the chosen module ref cannot supply, or what we deliberately",
      "differ on. master pins libp2p_module, openmetrics-module and",
      "logos-delivery in its flake lock, so those are derived.",
      "logos-logoscore-cli is not the module's own input: its lock only carries",
      "copies pulled in by other inputs (libp2p_module, logos-test-modules), and",
      "its docker-compose runs yet another. The harness keeps running 665ac28b,",
      "the version every recorded run used. `harness.sh resolve` shows each source."
    ],
    "logos-logoscore-cli": {
      "flake": "github:logos-co/logos-logoscore-cli",
      "rev": "665ac28bc77f45e3c610f40fef975a12609de531"
    }
  },
  "network": {
    "subnet": "10.0.0.0/8",
    "clusterId": 42,
    "shardsInNetwork": 1
  },
  "groups": [
    {
      "name": "bootstrap-native",
      "role": "bootstrap",
      "kind": "logosdeliverynode",
      "count": 1,
      "startAfter": 0,
      "ip": "10.0.0.10",
      "nodekey": "9999999999999999999999999999999999999999999999999999999999999999",
      "args": [
        "--entry-layer=kernel",
        "--relay=true",
        "--enable-kad-discovery=true",
        "--discv5-discovery=false",
        "--peer-exchange=false",
        "--rendezvous=false",
        "--dns-discovery=false",
        "--rest=false",
        "--metrics-logging=false",
        "--kad-service-lookup-interval=15",
        "--max-pure-libp2p-peers=200",
        "--log-level=DEBUG"
      ]
    },
    {
      "name": "bootstrap-module",
      "role": "bootstrap",
      "kind": "delivery-module",
      "count": 1,
      "startAfter": 0,
      "ip": "10.0.0.20",
      "nodekey": "8888888888888888888888888888888888888888888888888888888888888888",
      "env": {
        "LOOKUP_INTERVAL": "15"
      }
    },
    {
      "name": "native",
      "role": "member",
      "kind": "logosdeliverynode",
      "count": 15,
      "startAfter": 0,
      "args": [
        "--entry-layer=kernel",
        "--relay=true",
        "--enable-kad-discovery=true",
        "--discv5-discovery=false",
        "--peer-exchange=false",
        "--rendezvous=false",
        "--dns-discovery=false",
        "--rest=false",
        "--metrics-logging=false",
        "--kad-service-lookup-interval=15",
        "--max-pure-libp2p-peers=200",
        "--log-level=DEBUG"
      ]
    },
    {
      "name": "module",
      "role": "member",
      "kind": "delivery-module",
      "count": 15,
      "startAfter": 0,
      "jitter": 8,
      "env": {
        "LOOKUP_INTERVAL": "15"
      }
    },
    {
      "name": "late-2min-native",
      "role": "member",
      "kind": "logosdeliverynode",
      "count": 1,
      "startAfter": 120,
      "args": [
        "--entry-layer=kernel",
        "--relay=true",
        "--enable-kad-discovery=true",
        "--discv5-discovery=false",
        "--peer-exchange=false",
        "--rendezvous=false",
        "--dns-discovery=false",
        "--rest=false",
        "--metrics-logging=false",
        "--kad-service-lookup-interval=15",
        "--max-pure-libp2p-peers=200",
        "--log-level=DEBUG"
      ]
    },
    {
      "name": "late-12min-module",
      "role": "member",
      "kind": "delivery-module",
      "count": 1,
      "startAfter": 720,
      "env": {
        "LOOKUP_INTERVAL": "15"
      }
    }
  ]
}
