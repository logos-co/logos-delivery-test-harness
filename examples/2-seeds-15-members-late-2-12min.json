{
  "_comment": [
    "2 seeds, 15 members at T0 split between them, one late joiner at T0+2min",
    "and another at T0+12min. seed2 joins seed1's DHT on its own (the harness adds",
    "--kad-bootstrap-node); each member bootstraps from one seed, round-robin.",
    "A seed's peerId is derived from its nodekey.",
    "Run: HARNESS_MANIFEST=examples/2-seeds-15-members-late-2-12min.json ./harness.sh run 1800"
  ],
  "module": {
    "flake": "git+https://github.com/logos-co/logos-delivery-module",
    "ref": "master"
  },
  "overrides": {
    "logos-logoscore-cli": {
      "flake": "github:logos-co/logos-logoscore-cli",
      "rev": "665ac28bc77f45e3c610f40fef975a12609de531"
    }
  },
  "network": {
    "subnet": "10.0.0.0/8",
    "clusterId": 42,
    "shardsInNetwork": 1
  },
  "groups": [
    {
      "name": "seed1",
      "kind": "seed",
      "count": 1,
      "startAfter": 0,
      "ip": "10.0.0.10",
      "port": 44001,
      "nodekey": "9999999999999999999999999999999999999999999999999999999999999999",
      "args": [
        "--entry-layer=kernel",
        "--relay=true",
        "--enable-kad-discovery=true",
        "--discv5-discovery=false",
        "--peer-exchange=false",
        "--rendezvous=false",
        "--dns-discovery=false",
        "--rest=false",
        "--metrics-server=true",
        "--metrics-server-address=0.0.0.0",
        "--metrics-server-port=8008",
        "--metrics-logging=false",
        "--kad-service-lookup-interval=15",
        "--max-pure-libp2p-peers=200",
        "--log-level=DEBUG"
      ]
    },
    {
      "name": "seed2",
      "kind": "seed",
      "count": 1,
      "startAfter": 0,
      "ip": "10.0.0.20",
      "port": 44001,
      "nodekey": "8888888888888888888888888888888888888888888888888888888888888888",
      "args": [
        "--entry-layer=kernel",
        "--relay=true",
        "--enable-kad-discovery=true",
        "--discv5-discovery=false",
        "--peer-exchange=false",
        "--rendezvous=false",
        "--dns-discovery=false",
        "--rest=false",
        "--metrics-server=true",
        "--metrics-server-address=0.0.0.0",
        "--metrics-server-port=8008",
        "--metrics-logging=false",
        "--kad-service-lookup-interval=15",
        "--max-pure-libp2p-peers=200",
        "--log-level=DEBUG"
      ]
    },
    {
      "name": "members",
      "kind": "member",
      "count": 15,
      "startAfter": 0,
      "jitter": 8,
      "config": "member.json.tpl",
      "env": {
        "LOOKUP_INTERVAL": "15"
      }
    },
    {
      "name": "late-2min",
      "kind": "member",
      "count": 1,
      "startAfter": 120,
      "jitter": 0,
      "config": "member.json.tpl",
      "env": {
        "LOOKUP_INTERVAL": "15"
      }
    },
    {
      "name": "late-12min",
      "kind": "member",
      "count": 1,
      "startAfter": 720,
      "jitter": 0,
      "config": "member.json.tpl",
      "env": {
        "LOOKUP_INTERVAL": "15"
      }
    }
  ]
}
