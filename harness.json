{
  "_comment": [
    "One pin only: the logos-delivery-module ref. Every other component is derived",
    "from that module's own flake lock, so the harness always builds a coherent set.",
    "Use `overrides` to force a component away from what the module pins."
  ],

  "module": {
    "flake": "git+https://github.com/logos-co/logos-delivery-module",
    "ref": "master"
  },

  "overrides": {
    "_comment": [
      "Anything the chosen module ref does not pin has to be pinned here.",
      "master of logos-delivery-module pins only logos-delivery, so the three",
      "components below are the harness's own. A module ref that does pin them",
      "(the plugin-discovery branches) derives them instead -- drop the entry.",
      "logos-logoscore-cli: those branches lock 454e0696, the harness has always",
      "run 665ac28b; keep the override until you decide to follow the module."
    ],
    "libp2p_module": {
      "flake": "git+https://github.com/logos-co/logos-libp2p-module",
      "rev": "ec7b8f583781365389910da8b81688239661805d"
    },
    "openmetrics-module": {
      "flake": "github:logos-co/openmetrics-module",
      "rev": "f8da2a025cc2ff0ee2e284df5dc227fcfb0d6b68"
    },
    "logos-logoscore-cli": {
      "flake": "github:logos-co/logos-logoscore-cli",
      "rev": "665ac28bc77f45e3c610f40fef975a12609de531"
    }
  },

  "network": {
    "subnet": "10.0.0.0/8",
    "clusterId": 42,
    "shardsInNetwork": 1
  },

  "groups": [
    {
      "name": "seed",
      "kind": "seed",
      "count": 1,
      "startAfter": 0,
      "ip": "10.0.0.10",
      "port": 44001,
      "nodekey": "9999999999999999999999999999999999999999999999999999999999999999",
      "peerId": "16Uiu2HAm4gVVMqAzg2gT5cBii3qfaXykUJoB7jyHgAu71RuiELmz",
      "args": [
        "--entry-layer=kernel",
        "--relay=true",
        "--enable-kad-discovery=true",
        "--discv5-discovery=false",
        "--peer-exchange=false",
        "--rendezvous=false",
        "--dns-discovery=false",
        "--rest=false",
        "--metrics-server=true",
        "--metrics-server-address=0.0.0.0",
        "--metrics-server-port=8008",
        "--metrics-logging=false",
        "--kad-service-lookup-interval=15",
        "--max-pure-libp2p-peers=200",
        "--log-level=DEBUG"
      ]
    },
    {
      "name": "members",
      "kind": "member",
      "count": 3,
      "startAfter": 0,
      "jitter": 8,
      "config": "member.json.tpl",
      "env": { "LOOKUP_INTERVAL": "15" }
    }
  ]
}
